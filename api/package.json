{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@discord-bot/audio-control": "workspace:*",
    "@discord-bot/cache": "workspace:*",
    "@discord-bot/config": "workspace:*",
    "@discord-bot/database": "workspace:*",
    "@discord-bot/logger": "workspace:*",
    "@discord-bot/subscription": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "play-dl": "^1.9.7",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "ytdl-core": "^4.11.5",
    "zod": "^4.1.13"
  },
  "optionalDependencies": {
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^25.5.0",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
