{
  "version": 1,
  "sections": [
    {
      "id": "core",
      "title": "Core Discord",
      "variables": [
        { "key": "DISCORD_TOKEN", "category": "core", "classification": "env_only", "required": true, "default": "", "sensitive": true, "ownerAgent": "Gateway Agent", "description": "Token del bot principal de Discord" },
        { "key": "DISCORD_APPLICATION_ID", "category": "core", "classification": "env_only", "required": true, "default": "", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Application ID del bot" },
        { "key": "DISCORD_GUILD_ID", "category": "core", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Guild de desarrollo para comandos" },
        { "key": "DJ_ROLE_NAME", "category": "core", "classification": "mixed", "required": false, "default": "DJ", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Nombre del rol DJ por defecto" },
        { "key": "DEV_GUILD_IDS", "category": "core", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Guild IDs extra para desarrollo local" }
      ]
    },
    {
      "id": "infra",
      "title": "Infrastructure",
      "variables": [
        { "key": "DATABASE_URL", "category": "infra", "classification": "env_only", "required": true, "default": "postgresql://postgres:postgres@postgres:5432/discord", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "Conexion principal a PostgreSQL" },
        { "key": "TEST_DATABASE_URL", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "Conexion separada para tests" },
        { "key": "DATABASE_POOL_SIZE", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Tamano del pool DB" },
        { "key": "DATABASE_TIMEOUT", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Timeout de DB en ms" },
        { "key": "DATABASE_ENCRYPTION_KEY", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "Clave para cifrado de datos en repositorio" },
        { "key": "REDIS_URL", "category": "infra", "classification": "env_only", "required": true, "default": "redis://redis:6379", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Conexion principal a Redis" },
        { "key": "REDIS_DB", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Indice de DB Redis" },
        { "key": "REDIS_CLUSTER_NODES", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Nodos Redis Cluster comma-separated" },
        { "key": "LAVALINK_HOST", "category": "infra", "classification": "env_only", "required": true, "default": "lavalink", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Host de Lavalink (Docker-first: lavalink)" },
        { "key": "LAVALINK_PORT", "category": "infra", "classification": "env_only", "required": true, "default": "2333", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Puerto HTTP/WebSocket de Lavalink" },
        { "key": "LAVALINK_PASSWORD", "category": "infra", "classification": "env_only", "required": true, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Password de autenticacion de Lavalink" },
        { "key": "LAVALINK_IDENTIFIER", "category": "infra", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Identificador opcional del nodo Lavalink" },
        { "key": "LAVALINK_SECURE", "category": "infra", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Usar TLS para Lavalink" }
      ]
    },
    {
      "id": "service",
      "title": "Service Ports",
      "variables": [
        { "key": "PORT", "category": "service", "classification": "env_only", "required": false, "default": "3000", "sensitive": false, "ownerAgent": "API Agent", "description": "Puerto HTTP del servicio API" },
        { "key": "PORT_API", "category": "service", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Alias legacy de puerto API" },
        { "key": "HOST", "category": "service", "classification": "env_only", "required": false, "default": "0.0.0.0", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Host bind de servicios HTTP" },
        { "key": "GATEWAY_HTTP_PORT", "category": "service", "classification": "env_only", "required": true, "default": "3001", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Puerto health/metrics del gateway" },
        { "key": "AUDIO_HTTP_PORT", "category": "service", "classification": "env_only", "required": true, "default": "3002", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Puerto health/metrics del audio" },
        { "key": "WORKER_HTTP_PORT", "category": "service", "classification": "env_only", "required": true, "default": "3003", "sensitive": false, "ownerAgent": "Worker Agent", "description": "Puerto health/metrics del worker" }
      ]
    },
    {
      "id": "runtime",
      "title": "Runtime and Behavior",
      "variables": [
        { "key": "NODE_ENV", "category": "runtime", "classification": "env_only", "required": true, "default": "development", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Entorno de ejecucion" },
        { "key": "LOG_LEVEL", "category": "runtime", "classification": "mixed", "required": false, "default": "info", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Nivel de logging" },
        { "key": "ENV_DEBUG", "category": "runtime", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Activa logs de carga de env sin exponer secretos" },
        { "key": "GATEWAY_MANUAL_GC_ENABLED", "category": "runtime", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Habilita GC manual en gateway (recomendado false en Docker)" },
        { "key": "GATEWAY_GC_HEAP_THRESHOLD", "category": "runtime", "classification": "env_only", "required": false, "default": "0.9", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Umbral de heap para GC manual (0-1)" },
        { "key": "GATEWAY_GC_MIN_INTERVAL_MS", "category": "runtime", "classification": "env_only", "required": false, "default": "600000", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Cooldown minimo entre GC manuales en gateway (ms)" },
        { "key": "COMMANDS_CLEANUP_ON_START", "category": "runtime", "classification": "mixed", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Limpia comandos registrados al iniciar" },
        { "key": "COMMANDS_SCOPE", "category": "runtime", "classification": "mixed", "required": false, "default": "global", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Scope de registro de comandos: global|guild|both" },
        { "key": "NOWPLAYING_UPDATE_MS", "category": "runtime", "classification": "mixed", "required": false, "default": "5000", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Frecuencia de actualizacion de now playing (ms)" },
        { "key": "NOWPLAYING_CONTROL_MIN_INTERVAL_MS", "category": "runtime", "classification": "mixed", "required": false, "default": "200", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Intervalo minimo de push UI para cambios por controles (ms)" },
        { "key": "METRICS_IP_ALLOWLIST", "category": "runtime", "classification": "env_only", "required": false, "default": "127.0.0.1,::1,::ffff:127.0.0.1,172.20.,::ffff:172.20.", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "IPs/rangos permitidos para /metrics" }
      ]
    },
    {
      "id": "security",
      "title": "Security and API",
      "variables": [
        { "key": "API_KEY", "category": "security", "classification": "env_only", "required": true, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "API key interna entre panel/integraciones y API" },
        { "key": "WEBHOOK_SECRET", "category": "security", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Secreto HMAC para endpoints webhook" },
        { "key": "NEXTAUTH_SECRET", "category": "security", "classification": "env_only", "required": true, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Secreto de sesion NextAuth" },
        { "key": "PANEL_STREAM_SECRET", "category": "security", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Secreto dedicado para stream tokens del panel" },
        { "key": "ALLOWED_ORIGINS", "category": "security", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Orgenes CORS permitidos por API" },
        { "key": "CORS_ORIGINS", "category": "security", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Alias legacy para origenes CORS" }
      ]
    },
    {
      "id": "ratelimit",
      "title": "Rate Limiting",
      "variables": [
        { "key": "RATE_LIMIT_WINDOW_MS", "category": "ratelimit", "classification": "mixed", "required": false, "default": "900000", "sensitive": false, "ownerAgent": "API Agent", "description": "Ventana base de rate limit en ms" },
        { "key": "RATE_LIMIT_STRICT_WINDOW_MS", "category": "ratelimit", "classification": "mixed", "required": false, "default": "60000", "sensitive": false, "ownerAgent": "API Agent", "description": "Ventana strict de rate limit en ms" },
        { "key": "RATE_LIMIT_STRICT_MAX", "category": "ratelimit", "classification": "mixed", "required": false, "default": "20", "sensitive": false, "ownerAgent": "API Agent", "description": "Maximo requests para strict rate limit" },
        { "key": "API_RATE_LIMIT_DEFAULT_TIER", "category": "ratelimit", "classification": "mixed", "required": false, "default": "FREE", "sensitive": false, "ownerAgent": "API Agent", "description": "Tier por defecto para rate-limit" },
        { "key": "API_RATE_LIMIT_IN_MEMORY", "category": "ratelimit", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "API Agent", "description": "Fuerza store en memoria para rate-limit" }
      ]
    },
    {
      "id": "billing",
      "title": "Billing",
      "variables": [
        { "key": "PAYMENT_PROVIDER", "category": "billing", "classification": "env_only", "required": false, "default": "stripe", "sensitive": false, "ownerAgent": "API Agent", "description": "Proveedor de pagos: stripe|mercadopago" },
        { "key": "STRIPE_SECRET_KEY", "category": "billing", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Secret key de Stripe" },
        { "key": "STRIPE_WEBHOOK_SECRET", "category": "billing", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Webhook signing secret de Stripe" },
        { "key": "STRIPE_PRODUCT_BASIC", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID producto Stripe plan basic" },
        { "key": "STRIPE_PRODUCT_PREMIUM", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID producto Stripe plan premium" },
        { "key": "STRIPE_PRICE_BASIC_MONTHLY", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID precio mensual basic" },
        { "key": "STRIPE_PRICE_BASIC_YEARLY", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID precio anual basic" },
        { "key": "STRIPE_PRICE_PREMIUM_MONTHLY", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID precio mensual premium" },
        { "key": "STRIPE_PRICE_PREMIUM_YEARLY", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "ID precio anual premium" },
        { "key": "MERCADOPAGO_ACCESS_TOKEN", "category": "billing", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Token de acceso MercadoPago" },
        { "key": "MERCADOPAGO_WEBHOOK_SECRET", "category": "billing", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Secreto webhook MercadoPago" },
        { "key": "BILLING_PORTAL_URL", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "URL de portal de billing" },
        { "key": "BILLING_CURRENCY", "category": "billing", "classification": "mixed", "required": false, "default": "USD", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Moneda default para precios" },
        { "key": "UPGRADE_URL", "category": "billing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "URL de upgrade de plan" }
      ]
    },
    {
      "id": "music",
      "title": "Music Integrations",
      "variables": [
        { "key": "SPOTIFY_CLIENT_ID", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Spotify Client ID" },
        { "key": "SPOTIFY_CLIENT_SECRET", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Spotify Client Secret" },
        { "key": "DEEZER_ARL", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Cookie ARL de Deezer (LavaSrc)" },
        { "key": "APPLE_MUSIC_MEDIA_TOKEN", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Token de Apple Music (LavaSrc)" },
        { "key": "YOUTUBE_PO_TOKEN", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Proof-of-Origin token opcional para youtube-source" },
        { "key": "YOUTUBE_VISITOR_DATA", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "VisitorData opcional para youtube-source" },
        { "key": "YOUTUBE_TOKEN_AUTO_ENABLED", "category": "music", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Habilita refresh automatico de poToken/visitorData via libreria o endpoint" },
        { "key": "YOUTUBE_TOKEN_AUTO_REFRESH_MS", "category": "music", "classification": "env_only", "required": false, "default": "900000", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Intervalo de refresh automatico de tokens YouTube en ms (min 60000). 900000=15min evita corte ~30min por expiracion" },
        { "key": "YOUTUBE_TOKEN_AUTO_ENDPOINT", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Audio Agent", "description": "Endpoint opcional para obtener poToken/visitorData automaticamente (fallback del generador local)" },
        { "key": "YOUTUBE_TOKEN_AUTO_ENDPOINT_BEARER", "category": "music", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Audio Agent", "description": "Bearer token opcional para autenticar consultas al endpoint automatico de tokens YouTube" }
      ]
    },
    {
      "id": "panel",
      "title": "Web and Panel",
      "variables": [
        { "key": "NEXT_PUBLIC_API_BASE_URL", "category": "panel", "classification": "env_only", "required": true, "default": "http://localhost:3000", "sensitive": false, "ownerAgent": "API Agent", "description": "Base URL publica de la API para el panel" },
        { "key": "INTERNAL_API_BASE_URL", "category": "panel", "classification": "env_only", "required": true, "default": "http://localhost:3000", "sensitive": false, "ownerAgent": "API Agent", "description": "Base URL interna server-side del panel" },
        { "key": "NEXT_PUBLIC_PANEL_URL", "category": "panel", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "URL publica canonical del panel" },
        { "key": "NEXTAUTH_URL", "category": "panel", "classification": "env_only", "required": true, "default": "http://localhost:3004", "sensitive": false, "ownerAgent": "API Agent", "description": "URL canonical para NextAuth" },
        { "key": "NEXT_PUBLIC_PANEL_API_KEY", "category": "panel", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "Legacy (deprecated): no usar en browser; el panel usa BFF server-side" },
        { "key": "AUTH_DISCORD_CLIENT_ID", "category": "panel", "classification": "env_only", "required": true, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "OAuth Client ID de Discord" },
        { "key": "AUTH_DISCORD_CLIENT_SECRET", "category": "panel", "classification": "env_only", "required": true, "default": "", "sensitive": true, "ownerAgent": "API Agent", "description": "OAuth Client Secret de Discord" },
        { "key": "PANEL_STAFF_DISCORD_IDS", "category": "panel", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Fallback transicional de IDs staff del panel" },
        { "key": "NEXT_PUBLIC_PANEL_STAFF_DISCORD_IDS", "category": "panel", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Fallback transicional de IDs staff expuestos al panel" },
        { "key": "DISCORD_SUPERADMIN_USER_ID", "category": "panel", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "API Agent", "description": "Discord user ID bootstrap para rol SUPERADMIN" }
      ]
    },
    {
      "id": "observability",
      "title": "Observability and External Services",
      "variables": [
        { "key": "OTEL_EXPORTER_OTLP_ENDPOINT", "category": "observability", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Endpoint OTLP para trazas" },
        { "key": "SENTRY_DSN", "category": "observability", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "DSN de Sentry" },
        { "key": "SENTRY_ENVIRONMENT", "category": "observability", "classification": "env_only", "required": false, "default": "development", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Entorno reportado a Sentry" },
        { "key": "SENTRY_TRACES_SAMPLE_RATE", "category": "observability", "classification": "mixed", "required": false, "default": "0.1", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Sample rate de trazas (0-1)" },
        { "key": "SENTRY_PROFILES_SAMPLE_RATE", "category": "observability", "classification": "mixed", "required": false, "default": "0.1", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Sample rate de profiling (0-1)" },
        { "key": "ENABLE_PERFORMANCE_MONITORING", "category": "observability", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Shared/Infra Agent", "description": "Activa monitor de performance adicional" },
        { "key": "TAVILY_API_KEY", "category": "observability", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "API key de Tavily" },
        { "key": "OPENAI_API_KEY", "category": "observability", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "API key de OpenAI" },
        { "key": "GOOGLE_APPLICATION_CREDENTIALS", "category": "observability", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Shared/Infra Agent", "description": "Path a credenciales de servicio Google" }
      ]
    },
    {
      "id": "testing",
      "title": "Testing and Diagnostics",
      "variables": [
        { "key": "PREMIUM_TEST_GUILD_IDS", "category": "testing", "classification": "mixed", "required": false, "default": "", "sensitive": false, "ownerAgent": "Gateway Agent", "description": "Guild IDs con premium temporal de test" },
        { "key": "DISCORD_PROBE_TOKEN", "category": "testing", "classification": "env_only", "required": false, "default": "", "sensitive": true, "ownerAgent": "Test Agent", "description": "Token del bot sonda de audio" },
        { "key": "DISCORD_TEST_GUILD_ID", "category": "testing", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Test Agent", "description": "Guild objetivo para e2e de audio" },
        { "key": "DISCORD_TEST_USER_ID", "category": "testing", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Test Agent", "description": "User ID usado para disparar comandos e2e por Redis" },
        { "key": "DISCORD_TEST_VOICE_CHANNEL_ID", "category": "testing", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Test Agent", "description": "Canal de voz objetivo para e2e" },
        { "key": "DISCORD_TEST_TEXT_CHANNEL_ID", "category": "testing", "classification": "env_only", "required": false, "default": "", "sensitive": false, "ownerAgent": "Test Agent", "description": "Canal de texto objetivo para e2e" },
        { "key": "E2E_AUDIO_QUERY", "category": "testing", "classification": "env_only", "required": false, "default": "massano mute", "sensitive": false, "ownerAgent": "Test Agent", "description": "Query por defecto para test de audio" },
        { "key": "E2E_AUDIO_RMS_THRESHOLD", "category": "testing", "classification": "env_only", "required": false, "default": "0.015", "sensitive": false, "ownerAgent": "Test Agent", "description": "Umbral RMS para validar audio audible" },
        { "key": "E2E_AUDIO_CONSECUTIVE_WINDOWS", "category": "testing", "classification": "env_only", "required": false, "default": "8", "sensitive": false, "ownerAgent": "Test Agent", "description": "Ventanas consecutivas RMS sobre umbral" },
        { "key": "RUN_LOAD_TESTS", "category": "testing", "classification": "env_only", "required": false, "default": "false", "sensitive": false, "ownerAgent": "Test Agent", "description": "Habilita pruebas de carga locales" }
      ]
    }
  ]
}
