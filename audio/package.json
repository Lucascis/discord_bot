{
  "name": "audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@discord-bot/cache": "workspace:*",
    "@discord-bot/config": "workspace:*",
    "@discord-bot/database": "workspace:*",
    "@discord-bot/logger": "workspace:*",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "lavalink-client": "^2.9.1",
    "prom-client": "^15.1.3",
    "youtube-po-token-generator": "^0.6.0"
  },
  "optionalDependencies": {
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
