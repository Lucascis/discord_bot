{
  "extends": "@discord-bot/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["vitest/globals"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
